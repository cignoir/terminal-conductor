{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "terminal-conductor",
  "version": "0.1.3",
  "identifier": "io.github.cignoir.terminal-conductor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terminal Conductor",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Project-aware terminal for AI CLI sessions",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "cignoir",
    "homepage": "https://github.com/cignoir/terminal-conductor",
    "copyright": "Copyright (c) 2026 cignoir"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4Qzk2OTdGMDQxNkMyRUMKUldUc3doWUVmMm5KR1BmSTlNdEhpR3U5UlQ5N0FLZDd4YnozL1NDSzAzSHRPaUVIelFIUllmTEoK",
      "endpoints": [
        "https://github.com/cignoir/terminal-conductor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}